{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".vitepress/dist/**", "dist/**", "out/**"]
		},
		"build-chrome": {
			"dependsOn": ["^build"],
			"outputs": ["dist/chrome-mv3/**", "dist/*-chrome.zip"]
		},
		"build-firefox": {
			"dependsOn": ["^build"],
			"outputs": [
				"dist/firefox-mv2/**",
				"dist/*-sources.zip",
				"dist/*-firefox.zip"
			]
		},
		"typecheck": {},
		"lint": {},
		"lint-files": { "cache": false },
		"test": {
			"passThroughEnv": ["DOCKER_*", "TEST_*", "TESTCONTAINERS_*"],
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:container": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["API_URL", "YARN_INSTALL_STATE_PATH"]
		},
		"test-watch": {
			"cache": false,
			"persistent": true
		},
		"backend-graphql": {
			"cache": false,
			"passThroughEnv": ["BACKEND_GRAPHQL_URL"]
		}
	}
}
